{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/assets/[id]",
      "regex": "^/api/assets/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/assets/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/reservations/[id]/approve",
      "regex": "^/api/reservations/([^/]+?)/approve(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/reservations/(?<nxtPid>[^/]+?)/approve(?:/)?$"
    },
    {
      "page": "/api/reservations/[id]/cancel",
      "regex": "^/api/reservations/([^/]+?)/cancel(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/reservations/(?<nxtPid>[^/]+?)/cancel(?:/)?$"
    },
    {
      "page": "/api/reservations/[id]/complete-usage",
      "regex": "^/api/reservations/([^/]+?)/complete\\-usage(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/reservations/(?<nxtPid>[^/]+?)/complete\\-usage(?:/)?$"
    },
    {
      "page": "/api/reservations/[id]/reject",
