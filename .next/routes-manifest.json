      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/reservations/(?<nxtPid>[^/]+?)/reject(?:/)?$"
    },
    {
      "page": "/api/reservations/[id]/start-usage",
      "regex": "^/api/reservations/([^/]+?)/start\\-usage(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/reservations/(?<nxtPid>[^/]+?)/start\\-usage(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/approvals",
      "regex": "^/approvals(?:/)?$",
