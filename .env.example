APP_NAME="SIMA-R OJK Jawa Barat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-APP-NAME.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# =====================================================
# DATABASE - Neon PostgreSQL (https://neon.tech)
# Daftarkan akun gratis di neon.tech, buat project baru,
# copy connection string dan isi variabel di bawah ini.
# =====================================================
DB_CONNECTION=pgsql
DB_HOST=YOUR-NEON-HOST.neon.tech
DB_PORT=5432
DB_DATABASE=YOUR-DB-NAME
DB_USERNAME=YOUR-DB-USERNAME
DB_PASSWORD=YOUR-DB-PASSWORD
DB_SSLMODE=require

# =====================================================
# SESSION & CACHE - Gunakan cookie/array (serverless-friendly)
# =====================================================
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Queue harus sync di serverless (tidak ada worker background)
QUEUE_CONNECTION=sync

# Cache pakai array (tidak perlu DB/Redis di serverless)
CACHE_STORE=array

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ojk.go.id"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
